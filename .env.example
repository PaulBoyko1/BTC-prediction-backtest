# Chainlink Data Streams — request credentials/access from Chainlink.
# The reference ingestion script accepts either the CHAINLINK_* names below or
# the SDK's standard API_KEY / USER_SECRET names.
CHAINLINK_API_KEY=
CHAINLINK_USER_SECRET=
CHAINLINK_REST_ENDPOINT=https://api.dataengine.chain.link
CHAINLINK_WS_ENDPOINT=wss://ws.dataengine.chain.link

# CME DataMine — requires a CME API ID entitled to purchased/licensed files.
CME_DATAMINE_API_ID=
CME_DATAMINE_API_PASSWORD=

# Never commit a populated .env file or private API credentials.
